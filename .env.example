# API / database
DATABASE_URL="postgresql://postgres:password@localhost:5432/chess_realm?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
OWNER_EMAIL="owner@example.com"
FRONTEND_URL="http://localhost:5173"
PORT=4000
NODE_ENV=development

# AI (optional; regular chess modes work without it)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6-luna"
STOCKFISH_PATH="" # absolute path to a Stockfish UCI executable on the server

# Frontend
VITE_API_URL="http://localhost:4000"
VITE_SOCKET_URL="http://localhost:4000"
